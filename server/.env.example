# ═══════════════════════════════════════════════
# SERVER
# ═══════════════════════════════════════════════
NODE_ENV=development
PORT=5000

# ═══════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Redis (Upstash or local). Optional — the app runs without it, just uncached.
REDIS_URL=redis://localhost:6379

# ═══════════════════════════════════════════════
# AUTH
# ═══════════════════════════════════════════════
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ═══════════════════════════════════════════════
# FRONTEND URLS (used for CORS and for links inside emails)
# ═══════════════════════════════════════════════
CLIENT_USER_URL=http://localhost:5173
CLIENT_ADMIN_URL=http://localhost:5174

# ═══════════════════════════════════════════════
# CLOUDINARY — cover images and registration documents
# ═══════════════════════════════════════════════
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ═══════════════════════════════════════════════
# EMAIL (SMTP)
#
# Nodemailer is the client library, not the service — the service is whatever
# EMAIL_HOST points at. Switching provider is a change here, never in the code.
# Port 465 uses implicit TLS; 587 and 25 use STARTTLS. The server derives that
# from the port number, so do not try to force it.
#
# Hostinger (simplest when the From address is a Hostinger mailbox — the account
# already owns the address, so there is no domain verification step and no
# restriction on who you may write to):
#   EMAIL_HOST=smtp.hostinger.com
#   EMAIL_PORT=465          (or 587)
#   EMAIL_USER=abdillah@dealingspublishing.com     <- the full mailbox address
#   EMAIL_PASS=<the mailbox password from hPanel>
#
# Resend:
#   EMAIL_HOST=smtp.resend.com
#   EMAIL_PORT=465
#   EMAIL_USER=resend       <- literally the word "resend"
#   EMAIL_PASS=re_xxxxxxxx  <- an API key
#   The sending domain must show as Verified in the Resend dashboard. Until it
#   does, Resend only accepts messages addressed to your own account email.
#
# Gmail / Workspace:
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=465
#   EMAIL_USER=<full address>
#   EMAIL_PASS=<16-character App Password; 2-Step Verification required>
#
# Check any of these with:  npm run email:test -- you@example.com
# ═══════════════════════════════════════════════
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USER=abdillah@dealingspublishing.com
EMAIL_PASS=
EMAIL_FROM=abdillah@dealingspublishing.com

# Optional
EMAIL_FROM_NAME=Dealings Publishing
EMAIL_REPLY_TO=
# Set to true to print the full SMTP conversation into the server log
EMAIL_DEBUG=false

# Comma-separated fallback inbox(es) notified on every new event registration
# and every payment proof. Per-event addresses are configured in the admin panel;
# this is the catch-all.
ADMIN_NOTIFICATION_EMAIL=andiadzanbintang.work@gmail.com

# ═══════════════════════════════════════════════
# GOOGLE AI
# ═══════════════════════════════════════════════
GOOGLE_AI_API_KEY=
GEMMA_MODEL=
GEMINI_FALLBACK_MODEL=
EMBEDDING_MODEL=
