# ═══════════════════════════════════════════════
# SERVER
# ═══════════════════════════════════════════════
NODE_ENV=development
PORT=5000

# ═══════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Redis (Upstash or local). Optional — the app runs without it, just uncached.
REDIS_URL=redis://localhost:6379

# ═══════════════════════════════════════════════
# AUTH
# ═══════════════════════════════════════════════
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ═══════════════════════════════════════════════
# FRONTEND URLS (used for CORS and for links inside emails)
# ═══════════════════════════════════════════════
CLIENT_USER_URL=http://localhost:5173
CLIENT_ADMIN_URL=http://localhost:5174

# ═══════════════════════════════════════════════
# CLOUDINARY — cover images and registration documents
# ═══════════════════════════════════════════════
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ═══════════════════════════════════════════════
# EMAIL (SMTP)
# Gmail: smtp.gmail.com / 465 with an App Password (2-Step Verification must be
# on; "less secure app access" was removed in May 2025).
# ═══════════════════════════════════════════════
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Comma-separated fallback inbox(es) notified on every new event registration
# and every payment proof. Per-event addresses are configured in the admin panel;
# this is the catch-all.
ADMIN_NOTIFICATION_EMAIL=andiadzanbintang.work@gmail.com

# ═══════════════════════════════════════════════
# GOOGLE AI
# ═══════════════════════════════════════════════
GOOGLE_AI_API_KEY=
GEMMA_MODEL=
GEMINI_FALLBACK_MODEL=
EMBEDDING_MODEL=
